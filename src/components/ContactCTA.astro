---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
interface Props { heading?: string; }
const { heading = 'تواصل معنا الآن' } = Astro.props;
---

<section class="bg-brand-900 py-14">
  <div class="mx-auto max-w-4xl px-5 text-center lg:px-8">
    <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">{heading}</h2>
    <p class="mt-3 text-brand-200">
      📞 هاتف: {business.phone} &nbsp;|&nbsp; 💬 واتساب: {business.whatsapp} &nbsp;|&nbsp; 📍 {business.address.streetAddress}، {business.address.city}
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-4">
      <a href={business.phoneHref} class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 text-sm font-semibold text-brand-950 shadow-lg transition-all hover:bg-amber-400">
        <Icon name="lucide:phone" class="size-5" aria-hidden="true" /> اتصل الآن: {business.phone}
      </a>
      <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:bg-green-700">
        <Icon name="lucide:message-circle" class="size-5" aria-hidden="true" /> واتساب: {business.whatsapp}
      </a>
    </div>
  </div>
</section>
