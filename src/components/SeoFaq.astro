---
// قسم الأسئلة الشائعة + Schema.org FAQPage
interface Item { question: string; answer: string; }
interface Props { items: Item[]; title?: string; }
const { items, title = 'الأسئلة الشائعة' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<section class="py-16 lg:py-20">
  <div class="mx-auto max-w-3xl px-5 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-brand-900 sm:text-3xl">{title}</h2>
    <div class="mt-8 space-y-3">
      {items.map((item, i) => (
        <details class="group rounded-xl border border-stone-200 bg-white p-5 open:shadow-sm" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-stone-900">
            {item.question}
            <span class="shrink-0 text-brand-700 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
