---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { serviceUrl, areaUrl } from '../lib/urls';
---

<footer class="bg-brand-950 text-white">
  <div class="h-px w-full bg-gradient-to-r from-transparent via-brand-500/40 to-transparent" />

  <div class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8">
    <!-- الشعار + الوصف -->
    <div class="border-b border-white/10 pb-10">
      <a href="/" class="group inline-flex items-center gap-2.5">
        <div class="flex size-10 items-center justify-center rounded-lg bg-brand-800">
          <Icon name="lucide:layout-grid" class="size-5 text-brand-300" aria-hidden="true" />
        </div>
        <div class="flex flex-col">
          <span class="font-display text-lg font-bold text-white">مخزن نقشات الضجيج</span>
          <span class="text-[11px] font-medium text-stone-500">للسجاد والباركيه</span>
        </div>
      </a>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-stone-400">
        {business.tagline}. نخدم أهالي الكويت منذ عام {business.yearEstablished}.
      </p>
    </div>

    <!-- الأعمدة -->
    <div class="grid gap-8 pt-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-stone-500">خدماتنا</h3>
        <ul class="space-y-2.5">
          {serviceTypes.map((service) => (
            <li>
              <a href={serviceUrl(service.slug)} class="text-sm text-stone-400 transition-colors hover:text-white">
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-stone-500">مناطق الخدمة</h3>
        <ul class="space-y-2.5">
          {serviceAreas.map((area) => (
            <li>
              <a href={areaUrl(area.slug)} class="text-sm text-stone-400 transition-colors hover:text-white">
                {area.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider text-stone-500">معلومات التواصل</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:map-pin" class="mt-0.5 size-4 shrink-0 text-stone-500" aria-hidden="true" />
            <span class="text-sm text-stone-400">{business.address.streetAddress}، {business.address.city}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:phone" class="mt-0.5 size-4 shrink-0 text-stone-500" aria-hidden="true" />
            <a href={business.phoneHref} class="text-sm text-stone-400 transition-colors hover:text-white">{business.phone}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:message-circle" class="mt-0.5 size-4 shrink-0 text-stone-500" aria-hidden="true" />
            <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="text-sm text-stone-400 transition-colors hover:text-white">
              واتساب: {business.whatsapp}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:mail" class="mt-0.5 size-4 shrink-0 text-stone-500" aria-hidden="true" />
            <a href={`mailto:${business.email}`} class="text-sm text-stone-400 transition-colors hover:text-white">{business.email}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:clock" class="mt-0.5 size-4 shrink-0 text-stone-500" aria-hidden="true" />
            <div class="text-sm text-stone-400">
              {business.hours.map((schedule) => (
                <p>{schedule.days}: {schedule.hours}</p>
              ))}
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- الشريط السفلي -->
    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 sm:flex-row">
      <p class="text-xs text-stone-600">
        &copy; {new Date().getFullYear()} {business.name}. جميع الحقوق محفوظة.
      </p>
      <p class="text-xs text-stone-600">أكثر من {business.projectsCount}+ مشروع منذ {business.yearEstablished}</p>
    </div>
  </div>
</footer>
