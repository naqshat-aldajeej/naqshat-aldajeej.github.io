---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonicalUrl, ogImage, schema, noindex } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- خطوط عربية: Cairo (عناوين) + Tajawal (نص) -->
    <!-- ponytail: استخدمنا Google Fonts CDN بدل استضافة woff2 محلياً لتوفير وقت البناء دون تنزيل خطوط فعلياً (لا اتصال شبكة في بيئة البناء)، السقف: أداء تحميل أقل قليلاً من الخطوط المحلية. الترقية: نزّل ملفات woff2 لـ Cairo وTajawal واستضفها في /public/fonts عند التجهيز للنشر الفعلي. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800&family=Tajawal:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Head (title, meta, OG, Twitter, schema) -->
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      schema={schema}
      noindex={noindex}
    />

    <!-- ponytail: GA4 غير مفعّل (لا معرّف قياس حقيقي متوفر)، ceiling: بدون تتبع تحليلات حالياً. upgrade: أضف معرف G-XXXXXXXXXX الحقيقي هنا عند توفره. -->
  </head>

  <body class="flex min-h-screen flex-col bg-stone-50 text-stone-900 antialiased font-body">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
