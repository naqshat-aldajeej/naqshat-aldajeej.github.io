---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonicalUrl, ogImage, schema, noindex } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- خطوط عربية: Cairo (عناوين) + Tajawal (نص) -->
    <!-- ponytail: استخدمنا Google Fonts CDN بدل استضافة woff2 محلياً لتوفير وقت البناء دون تنزيل خطوط فعلياً (لا اتصال شبكة في بيئة البناء)، السقف: أداء تحميل أقل قليلاً من الخطوط المحلية. الترقية: نزّل ملفات woff2 لـ Cairo وTajawal واستضفها في /public/fonts عند التجهيز للنشر الفعلي. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800&family=Tajawal:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Head (title, meta, OG, Twitter, schema) -->
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      schema={schema}
      noindex={noindex}
    />

    <!-- Google Analytics 4 -->
    {
      business.analytics.ga4 && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${business.analytics.ga4}`}
          />
          <script is:inline define:vars={{ gaId: business.analytics.ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>

          {/* ponytail: مستمع واحد مفوَّض على مستوى الصفحة بدل إضافة onclick على كل
              رابط — يلتقط كل روابط واتساب/الهاتف الحالية *وأي رابط يُضاف مستقبلاً*
              تلقائياً، فلا يمكن أن يُنسى تتبّع رابط جديد. */}
          <script is:inline>
            document.addEventListener(
              'click',
              function (e) {
                var a = e.target && e.target.closest && e.target.closest('a[href]');
                if (!a || typeof window.gtag !== 'function') return;

                var href = a.getAttribute('href') || '';
                var method =
                  href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp') !== -1
                    ? 'whatsapp'
                    : href.indexOf('tel:') === 0
                      ? 'phone'
                      : null;
                if (!method) return;

                // موضع الرابط: يدوياً عبر data-ga-location، وإلا يُستنتج من البنية
                var host = a.closest('[data-ga-location]');
                var location = host
                  ? host.getAttribute('data-ga-location')
                  : a.closest('header')
                    ? 'header'
                    : a.closest('footer')
                      ? 'footer'
                      : 'content';

                window.gtag('event', 'contact_click', {
                  method: method,
                  link_location: location,
                  page_path: window.location.pathname,
                });
              },
              true
            );
          </script>
        </>
      )
    }
  </head>

  <body class="flex min-h-screen flex-col bg-stone-50 text-stone-900 antialiased font-body">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
