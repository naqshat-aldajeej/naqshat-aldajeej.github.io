---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../components/SeoFaq.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import { business } from '../../../data/business';
import { serviceTypes } from '../../../data/serviceTypes';
import { serviceAreas } from '../../../data/serviceAreas';
import { faqs } from '../../../data/seoContent';
import { comboUrl, areaUrl, areasUrl } from '../../../lib/urls';

const area = serviceAreas.find((a) => a.slug === 'hawally')!;
const nearbyAreas = serviceAreas.filter((a) => area.nearby.includes(a.slug));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}/areas/hawally/#service`,
      name: 'تركيب سجاد وباركيه وثيل صناعي في حولي',
      provider: { '@id': `${business.website}/#business` },
      areaServed: { '@type': 'City', name: 'حولي' },
      description: 'تركيب سجاد وباركيه وثيل صناعي احترافي في حولي. تشكيلة واسعة وأسعار تنافسية. أكثر من 1700 مشروع. اتصل 65061072',
      offers: { '@type': 'Offer', priceCurrency: 'KWD', availability: 'https://schema.org/InStock' },
    },
  ],
};
---

<BaseLayout
  title="تركيب سجاد وباركيه وثيل صناعي في حولي | مخزن نقشات الضجيج"
  description="✓ تركيب سجاد (زل وموكيت) وباركيه وثيل صناعي في حولي. أكثر من 1700 مشروع منذ 2019. اتصل 65061072 أو واتساب 96565061072"
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'المناطق', href: areasUrl() }, { label: 'حولي' }]} />

  <section class="py-10 lg:py-16">
    <div class="prose-editorial mx-auto max-w-3xl px-5 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold text-brand-900 sm:text-4xl">
        تركيب سجاد وباركيه وثيل صناعي في حولي
      </h1>
      <p class="mt-6">يثق سكان حولي بخبرتنا الممتدة منذ عام 2019 في تركيب السجاد والباركيه والثيل الصناعي، مع فريق يصل إلى موقعكم في حولي بمواعيد دقيقة.</p>

      <h2>خدماتنا في حولي</h2>
      <ul>
        {serviceTypes.map((s) => (
          <li><a href={comboUrl(s.slug, area.slug)}>{s.name} في حولي</a> — {s.shortDescription}</li>
        ))}
      </ul>

      <h2>لماذا يختارنا سكان حولي؟</h2>
      <ul>
        <li>خبرة واسعة في مشاريع حولي السكنية والتجارية</li>
        <li>أسعار تنافسية تناسب سكان حولي</li>
        <li>التزام بالمواعيد المتفق عليها</li>
        <li>ضمان على المنتجات والتركيب</li>
      </ul>

      <h2>مناطق قريبة نخدمها</h2>
      <p>
        بالإضافة إلى حولي، نصل بخدماتنا إلى المناطق المجاورة:{' '}
        {nearbyAreas.map((a, i) => (
          <>
            <a href={areaUrl(a.slug)}>{a.name}</a>{i < nearbyAreas.length - 1 ? '، ' : ''}
          </>
        ))}
      </p>

      <p>تواصلوا معنا اليوم عبر الهاتف أو الواتساب وسنكون بخدمتكم في حولي في أقرب وقت.</p>
    </div>
  </section>

  <SeoFaq items={faqs.filter(f => f.question.includes('مناطق') || f.question.includes('ساعات') || f.question.includes('ضمان'))} title="أسئلة شائعة عن خدماتنا في حولي" />
  <ContactCTA heading={`تواصل معنا لخدمتك في حولي`} />
</BaseLayout>
