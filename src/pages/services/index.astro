---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceUrl } from '../../lib/urls';

const serviceIcons: Record<string, string> = {
  carpets: 'lucide:layout-grid',
  parquet: 'lucide:layers',
  'artificial-grass': 'lucide:trees',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: serviceTypes.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: `${business.website}${serviceUrl(s.slug)}`,
  })),
};
---

<BaseLayout
  title={`خدماتنا | تركيب سجاد وباركيه وثيل صناعي | ${business.name}`}
  description="تعرف على جميع خدماتنا: تركيب سجاد (زل وموكيت)، باركيه، وثيل صناعي في جميع مناطق الكويت. أكثر من 1700 مشروع منذ 2019."
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'الخدمات' }]} />

  <section class="py-10 lg:py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold text-brand-900 sm:text-4xl">خدماتنا</h1>
      <p class="mt-4 max-w-2xl text-stone-600">
        نقدم ثلاث خدمات رئيسية بجودة عالية وتركيب احترافي في جميع مناطق الكويت: السجاد (الزل والموكيت)، الباركيه، والثيل الصناعي.
      </p>

      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        {serviceTypes.map((service) => (
          <a href={serviceUrl(service.slug)} class="card-hover group flex flex-col rounded-xl border border-stone-200 bg-white p-7">
            <div class="flex size-14 items-center justify-center rounded-lg bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-100">
              <Icon name={serviceIcons[service.slug] ?? 'lucide:box'} class="size-7" aria-hidden="true" />
            </div>
            <h2 class="mt-5 font-display text-xl font-bold text-brand-900">{service.name}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600">{service.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {service.keywords.slice(0, 3).map((k) => (
                <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs text-stone-500">{k}</span>
              ))}
            </div>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
              التفاصيل الكاملة <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
