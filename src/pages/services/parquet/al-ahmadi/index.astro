---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../../components/SeoFaq.astro';
import ContactCTA from '../../../../components/ContactCTA.astro';
import { business } from '../../../../data/business';
import { serviceAreas } from '../../../../data/serviceAreas';
import { faqs } from '../../../../data/seoContent';
import { comboUrl, serviceUrl, servicesUrl } from '../../../../lib/urls';

const area = serviceAreas.find((a) => a.slug === 'al-ahmadi')!;
const nearbyAreas = serviceAreas.filter((a) => area.nearby.includes(a.slug));

const productTypes = [
  'باركيه HDF',
  'باركيه خشبي طبيعي',
  'أرضيات laminate',
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}/services/parquet/al-ahmadi/#service`,
      name: 'باركيه في الأحمدي',
      provider: { '@id': `${business.website}/#business` },
      areaServed: { '@type': 'City', name: 'الأحمدي' },
      description: 'تركيب باركيه احترافي في الأحمدي. تشكيلة واسعة وأسعار تنافسية. أكثر من 1700 مشروع. اتصل 65061072',
      offers: { '@type': 'Offer', priceCurrency: 'KWD', availability: 'https://schema.org/InStock' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'الخدمات', item: `${business.website}${servicesUrl()}` },
        { '@type': 'ListItem', position: 3, name: 'باركيه', item: `${business.website}${serviceUrl('parquet')}` },
        { '@type': 'ListItem', position: 4, name: 'الأحمدي', item: `${business.website}${comboUrl('parquet', 'al-ahmadi')}` },
      ],
    },
  ],
};
---

<BaseLayout
  title="باركيه في الأحمدي | تركيب باركيه | مخزن نقشات الضجيج"
  description="✓ تركيب باركيه احترافي في الأحمدي. أكثر من 1700 مشروع منذ 2019. اتصل 65061072 أو واتساب 96565061072"
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'الخدمات', href: servicesUrl() }, { label: 'باركيه', href: serviceUrl('parquet') }, { label: 'الأحمدي' }]} />

  <section class="py-10 lg:py-16">
    <div class="prose-editorial mx-auto max-w-3xl px-5 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold text-brand-900 sm:text-4xl">
        باركيه في الأحمدي
      </h1>
      <p class="mt-6">الأحمدي من المناطق التي ننفذ فيها مشاريع تركيب باركيه بشكل متكرر ضمن محافظة الأحمدي، بأسعار تنافسية وجودة مضمونة.</p>

      <h2>الأنواع المتوفرة في الأحمدي</h2>
      <ul>
        {productTypes.map((t) => (
          <li>{t}</li>
        ))}
      </ul>

      <h2>لماذا يختارنا سكان الأحمدي؟</h2>
      <ul>
        <li>أكثر من 1700 مشروع منجز في الكويت</li>
        <li>مرونة في المواعيد تناسب جدولكم</li>
        <li>فريق يستمع لاحتياجاتكم قبل التنفيذ</li>
        <li>متابعة دورية لضمان رضاكم</li>
      </ul>

      <h2>مناطق قريبة نخدمها</h2>
      <p>
        بالإضافة إلى الأحمدي، نقدّم خدمة باركيه في المناطق المجاورة:{' '}
        {nearbyAreas.map((a, i) => (
          <>
            <a href={comboUrl('parquet', a.slug)}>{a.name}</a>{i < nearbyAreas.length - 1 ? '، ' : ''}
          </>
        ))}
      </p>

      <p>نسعد بخدمتكم في الأحمدي؛ تواصلوا معنا لمناقشة تفاصيل مشروعكم.</p>
    </div>
  </section>

  <SeoFaq items={faqs.filter(f => f.question.includes('باركيه') || f.question.includes('ساعات') || f.question.includes('مناطق'))} title="أسئلة شائعة عن باركيه في الأحمدي" />
  <ContactCTA heading={`تواصل معنا لخدمتك في الأحمدي`} />
</BaseLayout>
