---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../../components/SeoFaq.astro';
import ContactCTA from '../../../../components/ContactCTA.astro';
import { business } from '../../../../data/business';
import { serviceAreas } from '../../../../data/serviceAreas';
import { faqs } from '../../../../data/seoContent';
import { comboUrl, serviceUrl, servicesUrl } from '../../../../lib/urls';

const area = serviceAreas.find((a) => a.slug === 'al-jahra')!;
const nearbyAreas = serviceAreas.filter((a) => area.nearby.includes(a.slug));

const productTypes = [
  'ثيل صناعي للحدائق',
  'ثيل صناعي للبلكونات',
  'ثيل صناعي لأسطح المنازل',
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}/services/artificial-grass/al-jahra/#service`,
      name: 'ثيل صناعي في الجهراء',
      provider: { '@id': `${business.website}/#business` },
      areaServed: { '@type': 'City', name: 'الجهراء' },
      description: 'تركيب ثيل صناعي احترافي في الجهراء. تشكيلة واسعة وأسعار تنافسية. أكثر من 1700 مشروع. اتصل 65061072',
      offers: { '@type': 'Offer', priceCurrency: 'KWD', availability: 'https://schema.org/InStock' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'الخدمات', item: `${business.website}${servicesUrl()}` },
        { '@type': 'ListItem', position: 3, name: 'ثيل صناعي', item: `${business.website}${serviceUrl('artificial-grass')}` },
        { '@type': 'ListItem', position: 4, name: 'الجهراء', item: `${business.website}${comboUrl('artificial-grass', 'al-jahra')}` },
      ],
    },
  ],
};
---

<BaseLayout
  title="ثيل صناعي في الجهراء | تركيب ثيل صناعي | مخزن نقشات الضجيج"
  description="✓ تركيب ثيل صناعي احترافي في الجهراء. أكثر من 1700 مشروع منذ 2019. اتصل 65061072 أو واتساب 96565061072"
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'الخدمات', href: servicesUrl() }, { label: 'ثيل صناعي', href: serviceUrl('artificial-grass') }, { label: 'الجهراء' }]} />

  <section class="py-10 lg:py-16">
    <div class="prose-editorial mx-auto max-w-3xl px-5 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold text-brand-900 sm:text-4xl">
        ثيل صناعي في الجهراء
      </h1>
      <p class="mt-6">نقدم لعملائنا في الجهراء خدمة تركيب ثيل صناعي بفريق متخصص يعرف طبيعة المباني في محافظة الجهراء ويلتزم بالمواعيد المتفق عليها.</p>

      <h2>الأنواع المتوفرة في الجهراء</h2>
      <ul>
        {productTypes.map((t) => (
          <li>{t}</li>
        ))}
      </ul>

      <h2>لماذا يختارنا سكان الجهراء؟</h2>
      <ul>
        <li>فريق يصلكم في الجهراء بالوقت المحدد</li>
        <li>تشكيلة واسعة تناسب مختلف الأذواق والميزانيات</li>
        <li>معاينة ميدانية دقيقة قبل التسعير</li>
        <li>خدمة ما بعد التركيب</li>
      </ul>

      <h2>مناطق قريبة نخدمها</h2>
      <p>
        بالإضافة إلى الجهراء، نقدّم خدمة ثيل صناعي في المناطق المجاورة:{' '}
        {nearbyAreas.map((a, i) => (
          <>
            <a href={comboUrl('artificial-grass', a.slug)}>{a.name}</a>{i < nearbyAreas.length - 1 ? '، ' : ''}
          </>
        ))}
      </p>

      <p>فريقنا جاهز لاستقبال طلبكم من الجهراء والرد على جميع استفساراتكم.</p>
    </div>
  </section>

  <SeoFaq items={faqs.filter(f => f.question.includes('الثيل') || f.question.includes('ساعات') || f.question.includes('مناطق'))} title="أسئلة شائعة عن ثيل صناعي في الجهراء" />
  <ContactCTA heading={`تواصل معنا لخدمتك في الجهراء`} />
</BaseLayout>
