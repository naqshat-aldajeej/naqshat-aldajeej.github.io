---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../../components/SeoFaq.astro';
import ContactCTA from '../../../../components/ContactCTA.astro';
import { business } from '../../../../data/business';
import { serviceAreas } from '../../../../data/serviceAreas';
import { faqs } from '../../../../data/seoContent';
import { comboUrl, serviceUrl, servicesUrl } from '../../../../lib/urls';

const area = serviceAreas.find((a) => a.slug === 'al-salmiya')!;
const nearbyAreas = serviceAreas.filter((a) => area.nearby.includes(a.slug));

const productTypes = [
  'سجاد أمازون',
  'سجاد مسجد',
  'سجاد تركي',
  'سجاد حرير',
  'سجاد صوف',
  'الزل',
  'الموكيت',
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}/services/carpets/al-salmiya/#service`,
      name: 'تركيب سجاد في السالمية',
      provider: { '@id': `${business.website}/#business` },
      areaServed: { '@type': 'City', name: 'السالمية' },
      description: 'تركيب سجاد (زل وموكيت) احترافي في السالمية. تشكيلة واسعة وأسعار تنافسية. أكثر من 1700 مشروع. اتصل 65061072',
      offers: { '@type': 'Offer', priceCurrency: 'KWD', availability: 'https://schema.org/InStock' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'الخدمات', item: `${business.website}${servicesUrl()}` },
        { '@type': 'ListItem', position: 3, name: 'تركيب سجاد', item: `${business.website}${serviceUrl('carpets')}` },
        { '@type': 'ListItem', position: 4, name: 'السالمية', item: `${business.website}${comboUrl('carpets', 'al-salmiya')}` },
      ],
    },
  ],
};
---

<BaseLayout
  title="تركيب سجاد في السالمية | تركيب سجاد (زل وموكيت) | مخزن نقشات الضجيج"
  description="✓ تركيب سجاد (زل وموكيت) احترافي في السالمية. أكثر من 1700 مشروع منذ 2019. اتصل 65061072 أو واتساب 96565061072"
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'الخدمات', href: servicesUrl() }, { label: 'تركيب سجاد', href: serviceUrl('carpets') }, { label: 'السالمية' }]} />

  <section class="py-10 lg:py-16">
    <div class="prose-editorial mx-auto max-w-3xl px-5 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold text-brand-900 sm:text-4xl">
        تركيب سجاد في السالمية
      </h1>
      <p class="mt-6">هل تبحث عن تركيب سجاد (زل وموكيت) في السالمية؟ مخزن نقشات الضجيج للسجاد يقدم لك أفضل تشكيلة مع خدمة تركيب احترافية تصل إلى منزلك أو مكتبك في السالمية.</p>

      <h2>الأنواع المتوفرة في السالمية</h2>
      <ul>
        {productTypes.map((t) => (
          <li>{t}</li>
        ))}
      </ul>

      <h2>لماذا يختارنا سكان السالمية؟</h2>
      <ul>
        <li>توصيل سريع إلى السالمية والمناطق المجاورة</li>
        <li>تركيب احترافي بواسطة فريق متخصص</li>
        <li>أسعار تنافسية خاصة لأهل السالمية</li>
        <li>استشارة مجانية لاختيار الأنسب</li>
      </ul>

      <h2>مناطق قريبة نخدمها</h2>
      <p>
        بالإضافة إلى السالمية، نقدّم خدمة تركيب سجاد في المناطق المجاورة:{' '}
        {nearbyAreas.map((a, i) => (
          <>
            <a href={comboUrl('carpets', a.slug)}>{a.name}</a>{i < nearbyAreas.length - 1 ? '، ' : ''}
          </>
        ))}
      </p>

      <p>لا تتردد في التواصل معنا الآن لحجز معاينة مجانية في السالمية.</p>
    </div>
  </section>

  <SeoFaq items={faqs.filter(f => f.question.includes('سجاد') || f.question.includes('ساعات') || f.question.includes('مناطق'))} title="أسئلة شائعة عن تركيب سجاد في السالمية" />
  <ContactCTA heading={`تواصل معنا لخدمتك في السالمية`} />
</BaseLayout>
