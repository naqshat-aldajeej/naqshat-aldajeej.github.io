---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../../components/SeoFaq.astro';
import ContactCTA from '../../../../components/ContactCTA.astro';
import { business } from '../../../../data/business';
import { serviceAreas } from '../../../../data/serviceAreas';
import { faqs } from '../../../../data/seoContent';
import { comboUrl, serviceUrl, servicesUrl } from '../../../../lib/urls';

const area = serviceAreas.find((a) => a.slug === 'al-asimah')!;
const nearbyAreas = serviceAreas.filter((a) => area.nearby.includes(a.slug));

const productTypes = [
  'سجاد أمازون',
  'سجاد مسجد',
  'سجاد تركي',
  'سجاد حرير',
  'سجاد صوف',
  'الزل',
  'الموكيت',
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}/services/carpets/al-asimah/#service`,
      name: 'تركيب سجاد في العاصمة',
      provider: { '@id': `${business.website}/#business` },
      areaServed: { '@type': 'City', name: 'العاصمة' },
      description: 'تركيب سجاد (زل وموكيت) احترافي في العاصمة. تشكيلة واسعة وأسعار تنافسية. أكثر من 1700 مشروع. اتصل 65061072',
      offers: { '@type': 'Offer', priceCurrency: 'KWD', availability: 'https://schema.org/InStock' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'الخدمات', item: `${business.website}${servicesUrl()}` },
        { '@type': 'ListItem', position: 3, name: 'تركيب سجاد', item: `${business.website}${serviceUrl('carpets')}` },
        { '@type': 'ListItem', position: 4, name: 'العاصمة', item: `${business.website}${comboUrl('carpets', 'al-asimah')}` },
      ],
    },
  ],
};
---

<BaseLayout
  title="تركيب سجاد في العاصمة | تركيب سجاد (زل وموكيت) | مخزن نقشات الضجيج"
  description="✓ تركيب سجاد (زل وموكيت) احترافي في العاصمة. أكثر من 1700 مشروع منذ 2019. اتصل 65061072 أو واتساب 96565061072"
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'الخدمات', href: servicesUrl() }, { label: 'تركيب سجاد', href: serviceUrl('carpets') }, { label: 'العاصمة' }]} />

  <section class="py-10 lg:py-16">
    <div class="prose-editorial mx-auto max-w-3xl px-5 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold text-brand-900 sm:text-4xl">
        تركيب سجاد في العاصمة
      </h1>
      <p class="mt-6">العاصمة من المناطق التي ننفذ فيها مشاريع تركيب سجاد (زل وموكيت) بشكل متكرر ضمن محافظة العاصمة، بأسعار تنافسية وجودة مضمونة.</p>

      <h2>الأنواع المتوفرة في العاصمة</h2>
      <ul>
        {productTypes.map((t) => (
          <li>{t}</li>
        ))}
      </ul>

      <h2>لماذا يختارنا سكان العاصمة؟</h2>
      <ul>
        <li>أكثر من 1700 مشروع منجز في الكويت</li>
        <li>مرونة في المواعيد تناسب جدولكم</li>
        <li>فريق يستمع لاحتياجاتكم قبل التنفيذ</li>
        <li>متابعة دورية لضمان رضاكم</li>
      </ul>

      <h2>مناطق قريبة نخدمها</h2>
      <p>
        بالإضافة إلى العاصمة، نقدّم خدمة تركيب سجاد في المناطق المجاورة:{' '}
        {nearbyAreas.map((a, i) => (
          <>
            <a href={comboUrl('carpets', a.slug)}>{a.name}</a>{i < nearbyAreas.length - 1 ? '، ' : ''}
          </>
        ))}
      </p>

      <p>نسعد بخدمتكم في العاصمة؛ تواصلوا معنا لمناقشة تفاصيل مشروعكم.</p>
    </div>
  </section>

  <SeoFaq items={faqs.filter(f => f.question.includes('سجاد') || f.question.includes('ساعات') || f.question.includes('مناطق'))} title="أسئلة شائعة عن تركيب سجاد في العاصمة" />
  <ContactCTA heading={`تواصل معنا لخدمتك في العاصمة`} />
</BaseLayout>
