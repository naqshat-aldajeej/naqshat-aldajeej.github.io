---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import ContactCTA from '../components/ContactCTA.astro';
import SeoFaq from '../components/SeoFaq.astro';
import { business, yearsInBusiness } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { serviceUrl, areaUrl } from '../lib/urls';
import { faqs } from '../data/seoContent';

const years = yearsInBusiness();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${business.website}/#website`,
      url: business.website,
      name: business.name,
      description: business.description,
      publisher: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'HomeGoodsStore',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phoneIntl,
      email: business.email,
      description: business.description,
      foundingDate: `${business.yearEstablished}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.streetAddress,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: business.address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: business.hoursSchema.map((h) => ({
        '@type': 'OpeningHoursSpecification',
        ...h,
      })),
      priceRange: '$$',
      areaServed: serviceAreas.map((area) => ({ '@type': 'City', name: area.name })),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `منتجات ${business.name}`,
        itemListElement: serviceTypes.map((service) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: service.name, description: service.shortDescription },
        })),
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${business.website}/#webpage`,
      url: business.website,
      name: `${business.name} | تركيب سجاد وباركيه وثيل صناعي في الكويت`,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
      description: business.description,
    },
  ],
};

const serviceIcons: Record<string, string> = {
  carpets: 'lucide:layout-grid',
  parquet: 'lucide:layers',
  'artificial-grass': 'lucide:trees',
};
---

<BaseLayout
  title="مخزن نقشات الضجيج للسجاد | تركيب سجاد وباركيه وثيل صناعي في الكويت"
  description="✓ تركيب سجاد (زل وموكيت) وباركيه وثيل صناعي في الكويت. سجاد أمازون، سجاد مسجد. أكثر من 1700 مشروع منذ 2019. اتصل 65061072"
  schema={schema}
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-900 to-brand-800">
    <img
      src="/images/carpet-install-2.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 size-full object-cover opacity-25"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-brand-900/95 via-brand-900/80 to-brand-800/70" />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_rgba(217,119,6,0.18),_transparent_70%)]" />
    <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="max-w-2xl animate-fade-up">
        <h1 class="font-display text-4xl font-extrabold text-white sm:text-5xl lg:text-6xl">
          تركيب سجاد وباركيه وثيل صناعي في الكويت
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-brand-100">
          أكثر من {business.projectsCount}+ مشروع منذ {business.yearEstablished}. سجاد أمازون، سجاد مسجد، زل، موكيت، باركيه وثيل صناعي — تركيب احترافي يصل إلى باب منزلك في جميع مناطق الكويت.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={business.phoneHref} class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 text-sm font-semibold text-brand-950 shadow-lg transition-all hover:bg-amber-400 hover:shadow-xl">
            <Icon name="lucide:phone" class="size-5" aria-hidden="true" /> اتصل الآن: {business.phone}
          </a>
          <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/20">
            <Icon name="lucide:message-circle" class="size-5" aria-hidden="true" /> واتساب
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="bg-brand-950">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px sm:grid-cols-4">
      {[
        { icon: 'lucide:award', label: `+${business.projectsCount} مشروع منجز` },
        { icon: 'lucide:calendar', label: `منذ عام ${business.yearEstablished}` },
        { icon: 'lucide:shield-check', label: 'ضمان على المنتجات' },
        { icon: 'lucide:map-pin', label: 'نخدم جميع مناطق الكويت' },
      ].map((stat) => (
        <div class="flex items-center justify-center gap-3 bg-brand-950 px-4 py-5 text-center">
          <Icon name={stat.icon} class="size-5 shrink-0 text-amber-400" aria-hidden="true" />
          <span class="text-sm font-medium text-white">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ مقدمة ============ -->
  <section class="py-16 lg:py-20">
    <div class="prose-editorial mx-auto max-w-3xl px-5 lg:px-8">
      <p>
        مرحباً بكم في {business.name}، وجهتكم الأولى للسجاد (الزل والموكيت) والباركيه والثيل الصناعي في دولة الكويت. نحن متخصصون في تقديم منتجات عالية الجودة مع خدمة تركيب احترافية تصل إلى باب منزلك.
      </p>
      <p>
        منذ عام {business.yearEstablished}، نفخر بتنفيذ أكثر من {business.projectsCount} مشروع ناجح في جميع مناطق الكويت. سواء كنت تبحث عن سجاد أمازون عصري، أو سجاد مسجد فاخر، أو زل تقليدي، أو موكيت حديث، أو باركيه أنيق، أو ثيل صناعي لحديقتك — نوفر لك تشكيلة واسعة تلبي جميع الأذواق والميزانيات.
      </p>
    </div>
  </section>

  <!-- ============ الخدمات ============ -->
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold text-brand-900 sm:text-4xl">خدماتنا</h2>
        <p class="mx-auto mt-4 max-w-2xl text-stone-600">
          تشكيلة واسعة من السجاد والباركيه والثيل الصناعي بجودة عالية وأسعار تنافسية.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {serviceTypes.map((service, i) => (
          <a href={serviceUrl(service.slug)} class={`card-hover group overflow-hidden rounded-xl border border-stone-200 bg-white animate-fade-up stagger-${i + 1}`}>
            <div class="aspect-[4/3] w-full overflow-hidden bg-stone-100">
              <img
                src={service.image}
                alt={service.name}
                loading="lazy"
                width="480"
                height="360"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <div class="flex size-12 items-center justify-center rounded-lg bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-100">
                <Icon name={serviceIcons[service.slug] ?? 'lucide:box'} class="size-6" aria-hidden="true" />
              </div>
              <h3 class="mt-4 font-display text-lg font-bold text-brand-900">{service.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{service.shortDescription}</p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
                اقرأ المزيد <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ المناطق ============ -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold text-brand-900 sm:text-4xl">نخدم جميع مناطق الكويت</h2>
        <p class="mx-auto mt-4 max-w-2xl text-stone-600">اكتشف خدماتنا في منطقتك</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {serviceAreas.map((area) => (
          <a href={areaUrl(area.slug)} class="card-hover rounded-xl border border-stone-200 bg-white p-5 text-center">
            <Icon name="lucide:map-pin" class="mx-auto size-6 text-brand-700" aria-hidden="true" />
            <h3 class="mt-2 font-display text-sm font-bold text-brand-900">{area.name}</h3>
            <p class="mt-1 text-xs text-stone-500">خدماتنا تصلك</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ لماذا نحن ============ -->
  <section class="bg-brand-950 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">لماذا تختار {business.name}؟</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: 'lucide:award', title: `خبرة منذ ${business.yearEstablished}`, text: `أكثر من ${business.projectsCount} مشروع ناجح` },
          { icon: 'lucide:users', title: 'تركيب احترافي', text: 'بواسطة فريق متخصص' },
          { icon: 'lucide:badge-percent', title: 'أسعار تنافسية', text: 'تناسب جميع الميزانيات' },
          { icon: 'lucide:shield-check', title: 'جودة مضمونة', text: 'على جميع منتجاتنا' },
          { icon: 'lucide:truck', title: 'خدمة سريعة', text: 'التوصيل والتركيب' },
          { icon: 'lucide:badge-check', title: 'ضمان', text: 'على المنتجات والتركيب' },
        ].map((item) => (
          <div class="flex items-start gap-4 rounded-xl bg-brand-900/60 p-5">
            <Icon name={item.icon} class="size-6 shrink-0 text-amber-400" aria-hidden="true" />
            <div>
              <h3 class="font-display text-base font-bold text-white">{item.title}</h3>
              <p class="mt-1 text-sm text-brand-300">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SeoFaq items={faqs.slice(0, 6)} />
  <ContactCTA />
</BaseLayout>
